{
  "name": "riverguide-web",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun run scripts/build.ts",
    "dev": "bun run build && bunx wrangler dev --ip 127.0.0.1 --port 8787",
    "check": "bunx tsc --noEmit -p . && bunx tsc --noEmit -p app && bun test",
    "deploy": "bun run build && bunx wrangler deploy"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.79",
    "@ai-sdk/openai-compatible": "3.0.68",
    "@ai-sdk/xai": "5.0.21",
    "@fontsource-variable/aleo": "5.3.0",
    "@fontsource-variable/instrument-sans": "5.3.0",
    "@nationaldesignstudio/rampart-edge": "2.0.5",
    "ai": "7.0.140",
    "marked": "18.1.1",
    "onnxruntime-web": "1.30.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261014.1",
    "@types/bun": "1.4.2",
    "typescript": "7.0.2",
    "wrangler": "4.151.0"
  }
}
