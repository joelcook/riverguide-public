[Unit]
Description=RiverGuide MCP: search over Indian River State College's pages
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/Projects/riverguide
EnvironmentFile=%h/Projects/riverguide/.env
ExecStart=%h/Projects/riverguide/.venv/bin/python -m riverguide.server
Restart=always
RestartSec=5
UMask=0077

[Install]
WantedBy=default.target
