[Unit]
Description=Cloudflare tunnel for the model gateway (RiverGuide Worker -> Qwen)
After=network-online.target riverguide-model.service
Wants=riverguide-model.service

[Service]
ExecStart=/usr/bin/cloudflared tunnel --no-autoupdate --config %h/.cloudflared/riverguide-model.yml run
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
